#!/bin/bash
# postinst - first install and upgrade.
set -e

APP_ID="@@APP_ID@@"
APP_ROOT="/usr/local/${APP_ID}"
SHARE_NAME="@@SHARE_NAME@@"
DATA_DIR="/var/lib/${APP_ID}"
NGINX_ACTING="/etc/nginx/conf.d/${APP_ID}.conf"
UNIT_SRC="${APP_ROOT}/init.d/${APP_ID}.service"
UNIT_DST="/etc/systemd/system/${APP_ID}.service"
LOG="/var/log/${APP_ID}-maint.log"

echo "$(date '+%F %T') postinst $*" >> "$LOG" 2>/dev/null || true

case "$1" in
  configure)
    # 1. Frontend archive -> ${APP_ROOT}/webui (flat archive, index.html at root)
    if [ -f "${APP_ROOT}/webui.bz2" ]; then
      mkdir -p "${APP_ROOT}/webui"
      tar -xjf "${APP_ROOT}/webui.bz2" -C "${APP_ROOT}/webui" || true
      # The archive is built deterministically, so every member carries
      # mtime 0 and the platform's nginx would hand these files out with
      # "Last-Modified: Thu, 01 Jan 1970". A browser applies heuristic
      # caching to a response like that, which means an upgrade can keep
      # serving the previous entry page. Stamp them with the install time so
      # the freshness check has something real to work with.
      find "${APP_ROOT}/webui" -exec touch {} + 2>/dev/null || true
    fi

    # 2. App-owned runtime state. Never inside the shared folder.
    mkdir -p "${DATA_DIR}/bin" "${DATA_DIR}/.drive" "${DATA_DIR}/download"
    chown -R ${APP_ID}:${APP_ID} "${DATA_DIR}" 2>/dev/null || true
    # 2b. Runtime copy of the executables, on the system volume.
    #     TOS installs third-party applications on a storage volume
    #     (/Volume*/@apps/<appid>/, with /usr/local/<appid> symlinked to it) and
    #     protects /Volume* with the TerraMaster rich ACL. On TOS 7 builds where
    #     that ACL does not admit the application user - measured on a real
    #     TNAS, where no non-root user can traverse /Volume*/@apps at all - the
    #     unprivileged service cannot even read its own directory, and systemd
    #     fails the unit with 200/CHDIR. Running from a copy owned by the
    #     application user removes that dependency entirely. The copy is
    #     refreshed on every install, so an upgrade always carries the current
    #     engine.
    RUNTIME_DIR="${DATA_DIR}/runtime"
    mkdir -p "${RUNTIME_DIR}"
    for _f in "bin/${APP_ID}" "bin/xunlei-pan-cli-launcher.@@ARCH@@" \
              "bin/xunlei-pan-cli.@@ENGINE_VERSION@@.@@ARCH@@"; do
      if [ -f "${APP_ROOT}/${_f}" ]; then
        cp -f "${APP_ROOT}/${_f}" "${RUNTIME_DIR}/"
        # Only the files copied here get their mode set: the engine keeps its
        # own state in this tree on older installs and that must not change.
        chmod 0755 "${RUNTIME_DIR}/$(basename "${_f}")" 2>/dev/null || true
      fi
    done
    chown -R ${APP_ID}:${APP_ID} "${RUNTIME_DIR}" 2>/dev/null || true

    # 3. Shared folder for user-visible data (downloads + account state).
    #    Retained across upgrade and uninstall. The platform also declares
    #    it through config.ini.share_folders; this is the belt-and-braces
    #    path for manual `dpkg -i` installs.
    #
    #    -owner tells ter_share_add that the application user owns the
    #    folder and provisions the folder's own ACL entry. It does not, by
    #    itself, make the folder reachable: see 3a below.
    if [ -x /usr/sbin/ter_share_add ]; then
      SHARE_PATH="$(/usr/sbin/ter_share_add -name "${SHARE_NAME}" -owner "${APP_ID}" 2>/dev/null || true)"
      if [ -n "${SHARE_PATH}" ]; then
        # 3a. Traversal permission on the volume root.
        #
        #     Workaround for a TOS 7 platform defect; see
        #     docs/PLATFORM-DEFECT.md for the measurements, and for what has
        #     to change in the platform before this block can be deleted.
        #
        #     TerraMaster's rich ACL ("tmacl", the btrfs mount option behind
        #     /Volume*) is deny-by-default and does not fall back to the POSIX
        #     mode bits. Measured on a TNAS running TOS 7:
        #
        #       $ tmacltool get-perm /Volume1 <application uid>
        #       max_permission: -------------
        #
        #     even though that directory is mode 755, and `tmacltool get
        #     /Volume1` prints an empty list - no volume root on the system
        #     carries a single entry. Every non-root uid is refused as a
        #     result, not just this application's user: the built-in
        #     qbittorrent and transmission accounts and ordinary TOS users are
        #     refused in exactly the same way. Traversing a path needs
        #     permission at every level of it, so a correct entry on the
        #     shared folder stays unreachable while the volume root above it
        #     has none - which is why `ter_share_add -owner` on its own leaves
        #     the folder unusable for an unprivileged application.
        #
        #     The minimum repair is traversal only ("r-x"), with no
        #     inheritance, for this application's own user, on the single
        #     volume that holds the folder. Read and write authority is
        #     granted separately, on the folder itself, in 3b; this entry adds
        #     nothing beyond the ability to reach it.
        SHARE_VOL="$(printf '%s\n' "${SHARE_PATH}" | sed -n 's#^\(/Volume[0-9][0-9]*\)/.*#\1#p')"
        if [ -n "${SHARE_VOL}" ] && command -v tmacltool >/dev/null 2>&1; then
          if ! tmacltool modify "${SHARE_VOL}" "user:${APP_ID}:allow:r-x:--" >/dev/null 2>&1; then
            echo "$(date '+%F %T') WARNING: ${APP_ID} cannot traverse ${SHARE_VOL}; downloads will not reach ${SHARE_PATH}" >> "$LOG" 2>/dev/null || true
          fi
        fi

        mkdir -p "${SHARE_PATH}/download"

        # Non-recursive: an upgrade must never rewrite the ownership of an
        # existing download tree.
        chown ${APP_ID}:${APP_ID} "${SHARE_PATH}" "${SHARE_PATH}/download" 2>/dev/null || true

        # 3b. Read and write authority on the folder itself. This is the entry
        #     that governs the download directory, and it only takes effect
        #     together with the traversal entry from 3a. The first-party
        #     qBittorrent and Transmission applications make this same call
        #     (guide 10.6).
        if command -v tmacltool >/dev/null 2>&1; then
          tmacltool modify "${SHARE_PATH}" "user:${APP_ID}:allow:rwxpdDaARWc:fd" >/dev/null 2>&1 || true
          tmacltool modify "${SHARE_PATH}/download" "user:${APP_ID}:allow:rwxpdDaARWc:fd" >/dev/null 2>&1 || true
        fi

        # Members of allusers may open the folders the user shares with the
        # application (guide 10.6, second option).
        command -v usermod >/dev/null 2>&1 && usermod -aG allusers "${APP_ID}" >/dev/null 2>&1 || true
      fi
    fi

    # 3b. /etc/os-release repair (TOS platform defect).
    #    The legacy Xunlei application (xunleipan 2.9.1) replaces
    #    /etc/os-release with a symlink into its own ACL protected directory,
    #    and deletes it outright when it stops. The Xunlei engine reads
    #    /etc/os-release while detecting its platform and aborts with
    #    "panic: platform not suport" when that read fails. The engine runs as
    #    a dedicated non-root user here, so a readable file is mandatory.
    #    Restore one, without touching the content the distribution ships.
    if [ -f "${APP_ROOT}/os-release" ]; then
      if [ ! -e /etc/os-release ]; then
        install -m 0644 "${APP_ROOT}/os-release" /etc/os-release 2>/dev/null || true
        echo "$(date '+%F %T') restored missing /etc/os-release" >> "$LOG" 2>/dev/null || true
      elif ! su -s /bin/sh "${APP_ID}" -c 'test -r /etc/os-release' 2>/dev/null; then
        _tmp="$(mktemp /etc/.os-release.XXXXXX 2>/dev/null || true)"
        if [ -n "${_tmp}" ]; then
          if cat /etc/os-release > "${_tmp}" 2>/dev/null && [ -s "${_tmp}" ]; then
            chmod 0644 "${_tmp}"
            chown 0:0 "${_tmp}" 2>/dev/null || true
            mv -f "${_tmp}" /etc/os-release
            echo "$(date '+%F %T') repaired /etc/os-release for ${APP_ID}" >> "$LOG" 2>/dev/null || true
          else
            rm -f "${_tmp}"
          fi
        fi
      fi
    fi

    # 4. nginx route. The Jellyfin/Kavita-style pattern: the app ships the
    #    snippet, the lifecycle script activates it.
    if [ -f "${APP_ROOT}/nginx/${APP_ID}.conf" ] && [ -d /etc/nginx/conf.d ]; then
      cp -f "${APP_ROOT}/nginx/${APP_ID}.conf" "$NGINX_ACTING"
      systemctl reload nginx 2>/dev/null || service nginx reload 2>/dev/null || true
    fi

    # 5. Register and start the service.
    if [ -f "$UNIT_SRC" ]; then
      install -m 0644 "$UNIT_SRC" "$UNIT_DST"
      systemctl daemon-reload 2>/dev/null || true
      systemctl enable "${APP_ID}.service" 2>/dev/null || true
      systemctl restart "${APP_ID}.service" 2>/dev/null || true
    fi
    ;;
esac

exit 0